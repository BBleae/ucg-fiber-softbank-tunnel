#!/bin/bash
# tunnel.conf.example — UCG-Fiber IPIP6 隧道共享配置 (示例)
# 部署位置: /data/tunnel.conf
# 被 tunnel-watchdog.sh 和 tunnel-teardown.sh 引用
#
# 使用方法: cp tunnel.conf.example tunnel.conf 然后填入实际值

# ─── 隧道参数 ───
TUNNEL_SRC="2001:db8:1::1"           # 本地 IPv6 地址 (eth4 上的 IPoE 地址)
TUNNEL_DST="2001:db8:2::1"           # 隧道对端 IPv6 地址 (隧道服务商提供)
TUNNEL_DEV="eth4"                     # 承载 IPv6 的物理接口
TUNNEL_NAME="tun4"                    # 隧道接口名
IPV4_ADDR="203.0.113.1"              # 隧道分配的公网 IPv4 地址
MTU=1460

# ─── 内网 ───
LAN_SUBNET="192.168.1.0/24"

# ─── WAN 状态 hack ───
DSLITE_SRC="192.0.0.2"               # DS-Lite B4 地址 (通常不需要改)

# ─── 健康检查 ───
HEALTH_TARGETS=("8.8.8.8" "1.1.1.1") # 任一可达即视为健康
FAIL_COUNT_FILE="/tmp/tun4-fail-count"
FAIL_THRESHOLD=3                      # 连续失败次数 (每15秒检查, 共45秒) 后启用 WAN2 failover
HEALTH_TIMEOUT=3                      # 健康检查 ping 超时 (秒)

# ─── WAN2 (备用 ISP, 如 Starlink) failover ───
# metric 竞争模型: tun4(primary) metric 200, WAN2(failover) metric 100 (更低=优先)
# 两条 default 共存, 切换靠增删 WAN2 那条; tun4 default 永不删除 (保证健康检查路由)
WAN2_DEV="eth6"                       # WAN2 物理接口
WAN2_GW_FALLBACK="10.0.0.1"           # table 202.eth6 / udhcpc lease 都取不到网关时的兜底
TUNNEL_ROUTE_METRIC=200               # tun4 default 路由 metric
WAN2_ROUTE_METRIC=100                 # WAN2 failover default 路由 metric (必须 < TUNNEL_ROUTE_METRIC)
RECOVER_OK_THRESHOLD=3                # 恢复防抖: 连续 N 次健康才切回 tun4
FAILOVER_MIN_DWELL_SEC=60             # failover 后至少停留 M 秒才允许恢复 (避免抖动)

# ─── eth4 IPv6 丢失保护 (UCG 5.1.19 hb46pp 崩溃缓解) ───
# 背景: 固件 5.1.19 的 hb46pp(UniFi DS-Lite 客户端)在部分线路反复崩溃,
#   耗尽 CPU 致控制面死机, 连带 eth4 IPv6 源地址周期性丢失. 本保护在
#   eth4 IPv6 连续丢失达到阈值时重启 udapi-server 打断崩溃循环.
ETH4_IPV6_MISS_THRESHOLD=4            # 连续丢失次数 (每15秒1次, 4=约60秒)
UDAPI_RESTART_COOLDOWN_SEC=300        # 重启 udapi-server 冷却期 (秒), 防重启风暴

# ─── 日志 ───
LOG="/var/log/tunnel-watchdog.log"
MAX_LOG_BYTES=1048576                 # 1MB, 超过则轮转

# ─── IPv6 故障切换 ───
IPV6_FAILOVER=false  # LAN IPv6 前缀绑定主 WAN, 切出口后源地址不匹配; 仅当 WAN2 使用相同前缀时启用

# ─── 端口转发 ───
# 格式: "协议:外网端口:内网IP:内网端口"
# 添加/删除端口转发只需修改此数组, watchdog 和 teardown 会自动适配
PORT_FORWARDS=(
    "tcp:443:192.168.1.100:443"       # HTTPS 反向代理
    "tcp:25565:192.168.1.200:25565"   # Minecraft 服务器
)
